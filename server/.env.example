# ---- Server ----
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://your-frontend-domain.example.com

# ---- MySQL ----
# On Railway: create a MySQL plugin/service, it gives you these values
# (Railway also provides a single MYSQL_URL — either fill these in individually,
# or set DATABASE_URL and the app will parse it instead)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=fitforge
# Optional alternative: a full connection string (Railway/PlanetScale style)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# ---- JWT ----
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Resend (for verification code emails) ----
# Render's free tier blocks outbound SMTP (ports 25/465/587), so email is sent
# over Resend's HTTPS API instead of SMTP/nodemailer.
# 1. Sign up at https://resend.com (free tier: 100 emails/day, 3000/month)
# 2. Create an API key at https://resend.com/api-keys
# 3. RESEND_FROM: use "onboarding@resend.dev" to start with zero setup, or
#    verify your own domain at https://resend.com/domains and use
#    something like "FitForge <noreply@yourdomain.com>"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=FitForge <onboarding@resend.dev>

# Minutes before a verification code expires
VERIFICATION_CODE_TTL_MIN=15
