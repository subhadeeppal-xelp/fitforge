# ---- Server ----
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://your-frontend-domain.example.com

# ---- MySQL ----
# On Railway: create a MySQL plugin/service, it gives you these values
# (Railway also provides a single MYSQL_URL — either fill these in individually,
# or set DATABASE_URL and the app will parse it instead)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=fitforge
# Optional alternative: a full connection string (Railway/PlanetScale style)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# ---- JWT ----
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Gmail SMTP (for verification code emails) ----
# GMAIL_USER is the Gmail address sending the codes.
# GMAIL_APP_PASSWORD is a 16-character App Password from
# https://myaccount.google.com/apppasswords (NOT your normal Gmail password —
# requires 2-Step Verification to be enabled on the Google account first).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Minutes before a verification code expires
VERIFICATION_CODE_TTL_MIN=15
